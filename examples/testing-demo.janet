# 測試怎麼寫 —— 配合 docs/23-測試怎麼寫.md
#
# 跑法：janet examples/testing-demo.janet
#
# 這支的特別之處：它把「測試失敗」也**當成示範內容印出來**，所以自己一定跑得完、
# exit code 是 0。真正的測試檔不會這樣寫——真的測試就是讓它爆（見最後一段）。

(defn 標題 [s] (print "\n─── " s " ───"))

# ── 1. 一條測試就是一個 assert ────────────────────────────────────────────
(標題 "1. 最小的測試")

(assert (= 4 (+ 2 2)) "2+2 應該是 4")
(print "通過：2+2 = 4")

# assert 回傳的是「被檢查的值」，不是 true——所以可以串在資料流中間。
(def port (assert (scan-number "8080") "port 要是數字"))
(printf "assert 回傳被檢查的值：port = %q（不是 true）" port)

# ── 2. 失敗長什麼樣 ───────────────────────────────────────────────────────
(標題 "2. 失敗時的錯誤訊息")

# protect 把例外接下來變成 [成功? 值]，這裡拿它來「表演」失敗而不真的死掉。
(defn 示範失敗 [f]
  (def [ok e] (protect (f)))
  # ⚠ 訊息用 %s 不用 %q：%q 印的是「Janet 表示法」，會把中文逃逸成 \xE6\x9C\x88…
  (printf "  ok=%q  訊息=「%s」" ok e))

(示範失敗 |(assert (= 1 2) "月份要 0-based"))   # 有給訊息
(示範失敗 |(assert (= 1 2)))                     # 沒給訊息
(print "  ↑ 沒給訊息時只講「哪個運算式壞了」，不講「壞了代表什麼」")

# ── 3. 比較集合要用 deep= ─────────────────────────────────────────────────
(標題 "3. = 與 deep= 的差別")

(printf "(= @[1 2] @[1 2])     => %q   ← 比「是不是同一個物件」" (= @[1 2] @[1 2]))
(printf "(deep= @[1 2] @[1 2]) => %q   ← 比內容，測試要用這個" (deep= @[1 2] @[1 2]))

# ── 4. 斷言「這件事該失敗」 ───────────────────────────────────────────────
(標題 "4. 驗證錯誤路徑")

(defn parse-port [s]
  (or (scan-number s) (error "port 不是數字")))

(def [ok e] (protect (parse-port "abc")))
(assert (not ok) "壞輸入本來就該爆")
(assert (= e "port 不是數字") "錯誤訊息要講人話")
(printf "壞輸入有正確爆掉，訊息是「%s」" e)

# ⚠ 陷阱：Janet 很多你以為會爆的事其實不會爆，
#    拿它們當「該失敗」的測試會寫出永遠不會紅的假測試。
(printf "(/ 1 0)      => %q   ← 不是錯誤！" (/ 1 0))
(printf "(get nil :a) => %q   ← 也不是錯誤" (get nil :a))

# ── 5. 浮點數不要直接比 = ─────────────────────────────────────────────────
(標題 "5. 浮點數要比差值")

(def got (+ 0.1 0.2))
(printf "(+ 0.1 0.2) = %.20f" got)
(printf "(= got 0.3)                      => %q" (= got 0.3))
(printf "(< (math/abs (- got 0.3)) 1e-9)  => %q   ← 測試要這樣寫"
        (< (math/abs (- got 0.3)) 1e-9))

# ── 6. 真的測試檔長什麼樣 ─────────────────────────────────────────────────
(標題 "6. 放進 test/ 的版本")

(print ``
  # test/my-feature.janet —— 這才是真的測試檔的樣子：
  #   * 不 protect，讓它直接爆，jpm test 才看得到非 0 的 exit code
  #   * 每個 assert 都給一句話說明「壞了代表什麼」
  #   * 最後印一行通過，才看得出它真的跑到底

  (import ../my-module :as m)

  (assert (= 4 (m/double 2))        "double 基本情況")
  (assert (deep= @[] (m/double @[])) "double 吃空集合不會爆")
  (assert (not (first (protect (m/double "x")))) "非數字要拋錯")

  (print "my-feature 測試通過 ✓")
``)

(print "\n全部示範跑完（這支自己的 exit code 是 0）。")
