# 配合 course/1-2-括號怎麼讀.md

(print "== 最簡單的式子 ==")
(print (+ 1 2))     # 3
(print (- 10 4))    # 6
(print (* 3 6))     # 18

(print "== 一個動作吃好幾個參數 ==")
(print (+ 1 2 3))       # 6
(print (+ 1 2 3 4 5))   # 15
(print (* 2 3 4))       # 24
(print (- 10 4 1))      # 5

(print "== 巢狀怎麼用眼睛讀 ==")
# (1 + 2) * (10 - 4)
(print "整串：" (* (+ 1 2) (- 10 4)))    # 18
(print "第一步：" (+ 1 2) " 和 " (- 10 4)) # 3 和 6
(print "第二步：" (* 3 6))                # 18
# 20 - 2 * (3 + 4)
(print "整串：" (- 20 (* 2 (+ 3 4))))    # 6
(print "拆開：" (+ 3 4) " -> " (* 2 7) " -> " (- 20 14))

(print "== 註解 ==")
# 這整行都是註解
(print (+ 1 2 # 這裡也可以寫
          3))   # 6

(print "== 換行和縮排只是給人看的 ==")
(print (* (+ 1 2) (- 10 4)))
(print (*
         (+ 1 2)
         (- 10 4)))

(print "== 括號沒對上會怎樣 ==")
(pp (protect (eval-string "(+ 1 2")))
(pp (protect (eval-string "(+ 1 2))")))

(print "== 坑：動作要寫最前面 ==")
(pp (protect (eval-string "(1 + 2)")))

# ---- 練習解答 ----
(print "== 練習解答 ==")
# 1. (2 + 3) * (7 - 1)
(print (* (+ 2 3) (- 7 1)))          # 30
# 2. 100 - 5 * (2 + 8)
(print (- 100 (* 5 (+ 2 8))))        # 50
# 3. 1 到 6 全部相加
(print (+ 1 2 3 4 5 6))              # 21
