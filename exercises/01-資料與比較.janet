# 答案在 exercises/solutions/01-資料與比較.janet——先自己跑過錯的再看。

(def 未完成 :還沒寫)

# ── 題目 ──────────────────────────────────────────────────────

# 1. 判斷兩個「內容相同」的 array 是不是一樣。
#    ⚠ 直接用 = 會給你 false（見 docs/02）。
(defn 內容相同? [a b]
  未完成)

# 2. 給一個 table，回一份**改了不會影響原本**的完整拷貝（含內層）。
#    ⚠ table/clone 只有一層（見 docs/35）。
(defn 深拷貝 [t]
  未完成)

# 3. 拿掉陣列裡重複的元素，**保持第一次出現的順序**。
#    ⚠ 內建 distinct 不保證順序合你的預期，自己做比較穩（見 docs/25）。
(defn 去重 [xs]
  未完成)

# 4. 用「一對座標」當字典的鍵，存進去再取出來。
#    ⚠ array 當鍵取不回來——它比的是「是不是同一個物件」（見 docs/02）。
#    回傳存好的那張 table。
(defn 座標表 [x y 值]
  未完成)

# 5. 把 @{:b 2 :a 1} 這種 table 印成**順序固定**的字串，格式 "a=1,b=2"。
#    ⚠ (keys t) 出來是 hash 序，每次都一樣但不是你想要的順序（見 docs/25）。
(defn 穩定字串 [t]
  未完成)

# 6. 合併兩張 struct，右邊蓋左邊，而且**結果也要是不可變的**。
#    ⚠ merge 一律回 table（見 docs/35b）。
(defn 合併成不可變 [a b]
  未完成)

# ── 檢查（不用改這裡）──────────────────────────────────────────

(var 過 0) (var 錯 0)
(defn 檢查 [n 說明 提示 實得 預期]
  (if (deep= 實得 預期)
    (++ 過)
    (do (++ 錯)
        (printf "✘ 第 %d 題：%s\n    預期 %j\n    實得 %j\n    提示 %s"
                n 說明 預期 實得 提示))))

(檢查 1 "內容相同的 array" "docs/02：可變容器的 = 比身分，要比內容用 deep="
       [(內容相同? @[1 2] @[1 2]) (內容相同? @[1 2] @[1 3])]
       [true false])

(def 原 @{:a @[1 2]})
(def 拷 (深拷貝 原))
(when (dictionary? 拷) (array/push (get 原 :a) 99))
(檢查 2 "深拷貝之後改原本，拷貝不受影響" "docs/35：thaw ∘ freeze"
       (get 拷 :a) @[1 2])

(檢查 3 "拿掉重複的元素" "docs/25；順序要照第一次出現"
       (去重 [3 1 3 2 1]) @[3 1 2])

(檢查 4 "用座標當字典的鍵" "docs/02：只有不可變的（tuple／struct）當得了鍵"
       (let [t (座標表 3 4 :寶藏)] (if (dictionary? t) (get t [3 4]) t))
       :寶藏)

(檢查 5 "順序固定的字串" "docs/25：keys 是 hash 序，自己 sort"
       (穩定字串 @{:b 2 :a 1}) "a=1,b=2")

(檢查 6 "合併成不可變" "docs/35b：merge 回的是 table，要再 freeze"
       (let [r (合併成不可變 {:a 1} {:b 2 :a 9})]
         [(type r) (get r :a) (get r :b)])
       [:struct 9 2])

(printf "\n過 %d 題，錯 %d 題" 過 錯)
(if (zero? 錯)
  (print "✓ 全部通過")
  (print "改一題跑一次就好，不用一次寫完。"))
