# ── 題目 ──────────────────────────────────────────────────────

# 1. 判斷一個值是不是「空的」——空字串、空陣列、空字典、nil 都算空。
#    ⚠ (if x …) 判不出來：0、""、@[] 在 Janet 全是**真**（見 docs/32）。
(defn 空的? [x]
  未完成)

# 2. 寫一個迷你求值器：吃 [:+ a b] / [:* a b] / 數字，回算出來的值。
#    可以巢狀，例如 [:* [:+ 1 2] 10] => 30。
(defn 算 [e]
  未完成)

# 3. 判斷一個 tuple 是不是**剛好三格**。
#    ⚠ (match v [a b c] true _ false) 是錯的——tuple 模式是**前綴**比對，
#      四格的東西也會中（見 docs/32）。
(defn 剛好三格? [v]
  未完成)

# 4. 從巢狀設定裡取出 [:server :port]，取不到就回 8080。
#    ⚠ 中間任何一層是 nil 都不能炸。
(defn 取-port [cfg]
  未完成)

# 5. 把一串數字裡的奇數挑出來、各乘 10、加總。用執行緒巨集寫成一條管線。
#    ⚠ 想清楚該用 -> 還是 ->>（見 docs/01c）。
(defn 奇數乘十加總 [xs]
  未完成)

# 6. 收集 0..n-1 裡「3 的倍數」的平方，但**遇到大於 100 的就停**。
#    ⚠ :when 是過濾（繼續跑），:while 才是中止（見 docs/32b）。
(defn 小平方 [n]
  未完成)

# ── 檢查（不用改這裡）──────────────────────────────────────────

(var 過 0) (var 錯 0)
(defn 檢查 [n 說明 提示 實得 預期]
  (if (deep= 實得 預期)
    (++ 過)
    (do (++ 錯)
        (printf "✘ 第 %d 題：%s\n    預期 %j\n    實得 %j\n    提示 %s"
                n 說明 預期 實得 提示))))

(檢查 1 "判斷空的" "docs/32：只有 nil 和 false 是假，0 和 \"\" 都是真"
       (map 空的? ["" @[] @{} nil "a" @[1] 0])
       @[true true true true false false false])

(檢查 2 "迷你求值器" "docs/32：match 的常值 + 遞迴"
       [(算 5) (算 [:+ 1 2]) (算 [:* [:+ 1 2] 10])]
       [5 3 30])

(檢查 3 "剛好三格" "docs/32：tuple 模式是前綴比對，要自己檢查 length"
       (map 剛好三格? [[1 2 3] [1 2] [1 2 3 4] "abc"])
       @[true false false false])

(檢查 4 "取 port" "docs/20：get-in 的第三參數，或 -?>"
       [(取-port {:server {:port 4000}}) (取-port {:server {}}) (取-port {})]
       [4000 8080 8080])

(檢查 5 "奇數乘十加總" "docs/01c：資料在最後一個參數 → 用 ->>"
       (奇數乘十加總 [1 2 3 4 5]) 90)

(檢查 6 "小平方" "docs/32b：:while 才會中止，:when 只是過濾"
       (小平方 20) @[0 9 36 81])

(printf "\n過 %d 題，錯 %d 題" 過 錯)
(if (zero? 錯)
  (print "✓ 全部通過")
  (print "改一題跑一次就好，不用一次寫完。"))
