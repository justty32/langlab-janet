# ── 檢查（不用改這裡）──────────────────────────────────────────

(var 過 0) (var 錯 0)
(defn 檢查 [n 說明 提示 實得 預期]
  (if (deep= 實得 預期)
    (++ 過)
    (do (++ 錯)
        (printf "✘ 第 %d 題：%s\n    預期 %j\n    實得 %j\n    提示 %s"
                n 說明 預期 實得 提示))))

(def c1 (做計數器))
(def c2 (做計數器))
# ⚠ 這裡用 apply 不用直接 (c1)——還沒寫時 c1 是個 keyword，
#   而「keyword 用 0 個參數呼叫」是**編譯期**錯誤，if 擋不住（docs/33）。
(defn 安全叫 [f] (if (function? f) (apply f []) :還沒寫))
(檢查 1 "兩個獨立的計數器" "docs/33：var 放在工廠函式裡，每次呼叫各一份"
       [(安全叫 c1) (安全叫 c1) (安全叫 c1) (安全叫 c2)]
       [1 2 3 1])

(檢查 2 "&opt 配 default" "docs/33：(default y 10)"
       [(帶預設 1) (帶預設 1 2)] [[1 10] [1 2]])

(檢查 3 "可變參數總和" "docs/33：[& xs] 收成 tuple"
       [(總和) (總和 1 2 3)] [0 6])

(檢查 4 "迴圈裡的三個閉包" "docs/33：圈內 let 複製一份出來"
       (let [fs (三個閉包)]
         (if (and (indexed? fs) (= 3 (length fs)) (all function? fs))
           (map |($) fs) fs))
       @[0 1 2])

(def [快取版 次數] (let [r (memoize (fn [x] (* x x)))] (if (indexed? r) r [nil nil])))
(檢查 5 "memoize" "docs/33：閉包裡放一張 table 當快取"
       (if 快取版
         [(快取版 4) (快取版 4) (快取版 5) (get 次數 :算過幾次)]
         :還沒寫)
       [16 16 25 2])

(檢查 6 "具名參數組網址" "docs/33：&named 各自綁成變數，沒給就是 nil"
       [(組網址 :host "x" :port 80) (組網址 :host "y")]
       ["http://x:80" "https://y:443"])

(printf "\n過 %d 題，錯 %d 題" 過 錯)
(if (zero? 錯)
  (print "✓ 全部通過")
  (print "改一題跑一次就好，不用一次寫完。"))
